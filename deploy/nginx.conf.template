server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    location = /api/health {
        proxy_pass http://127.0.0.1:3100;
    }

    location /g/ {
        auth_basic off;
        proxy_pass http://127.0.0.1:3100;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /_next/ {
        auth_basic off;
        proxy_pass http://127.0.0.1:3100;
        proxy_set_header Host $host;
    }

    location = /favicon.svg {
        auth_basic off;
        proxy_pass http://127.0.0.1:3100;
    }

    location / {
        auth_basic "Личный музыкальный квиз";
        auth_basic_user_file /etc/nginx/.htpasswd-music-quiz;
        proxy_pass http://127.0.0.1:3100;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
